{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    { "name": "app", "installMode": "prefetch", "updateMode": "prefetch", "resources": { "files": ["/index.html", "/manifest.webmanifest", "/main-*.js", "/styles-*.css", "/assets/favicon.svg", "/assets/icons/*.png"] } },
    { "name": "parts", "installMode": "lazy", "updateMode": "lazy", "resources": { "files": ["/*.js", "/*.css", "/assets/*.(png|jpg|svg|pdf)", "/assets/sql/**", "/assets/pdf/**", "/assets/study/**/*.(json|bin|txt|html)"], "urls": ["https://fonts.googleapis.com/**", "https://fonts.gstatic.com/**"] } }
  ],
  "navigationUrls": ["/"]
}
